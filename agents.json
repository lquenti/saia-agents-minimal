{
  "agent": {
    "name": "Advanced Coding Agent",
    "version": "2.0.0",
    "description": "Isolated coding agent with pre-installed skills - supports OpenCode and OpenClaude runtimes"
  },
  "runtime": {
    "supported": ["opencode", "openclaude"],
    "default": "opencode"
  },
  "skills": {
    "enabled": [
      "github",
      "git",
      "fileops",
      "shell",
      "web",
      "diffs",
      "session-logs",
      "python"
    ],
    "disabled": [
      "voice-call",
      "browser-automation"
    ]
  },
  "security": {
    "allowExternalCalls": false,
    "allowNetworkAccess": false,
    "blockedCommands": [
      "rm -rf /",
      "dd",
      "mkfs",
      "fdisk",
      "partition",
      "chmod -R 777",
      "chown -R root",
      "sudo",
      "su",
      "passwd"
    ],
    "maxFileSize": 104857600,
    "allowedDirectories": [
      "/home/agent/workspace/projects",
      "/home/agent/workspace/docs",
      "/home/agent/workspace/temp"
    ]
  },
  "workspace": {
    "defaultPath": "/home/agent/workspace/projects",
    "maxProjects": 10,
    "autoCommit": false
  },
  "memory": {
    "enabled": true,
    "path": "/home/agent/.opencode/memory",
    "format": "markdown",
    "autoSave": true,
    "maxContextTokens": 2000
  },
  "logging": {
    "level": "info",
    "path": "/home/agent/workspace/logs",
    "maxSize": "100M",
    "maxFiles": 10
  },
  "python": {
    "manager": "uv",
    "version": "3.11",
    "packages": [
      "pytest",
      "black",
      "ruff",
      "mypy"
    ]
  }
}
