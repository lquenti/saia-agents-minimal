# OpenClaude Environment Configuration
# Copy this to .env and fill in your API keys
# ⚠️ NEVER commit .env to git!

# ============================================
# LLM Provider API Keys (Choose one or more)
# ============================================

# Anthropic (Claude - Primary for OpenClaude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (Fallback)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini (Fallback)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# DeepSeek (Fallback)
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# OpenClaude Configuration
# ============================================

# Default model to use
OPENCLAUDE_DEFAULT_MODEL=anthropic

# Enable/disable features
OPENCLAUDE_ENABLE_GIT=true
OPENCLAUDE_ENABLE_GITHUB=true
OPENCLAUDE_ENABLE_FILEOPS=true
OPENCLAUDE_ENABLE_SHELL=true
OPENCLAUDE_ENABLE_WEB=true
OPENCLAUDE_ENABLE_MEMORY=true

# Security settings
OPENCLAUDE_SAFE_MODE=true
OPENCLAUDE_BLOCK_DANGEROUS_COMMANDS=true
OPENCLAUDE_MAX_FILE_SIZE=104857600

# Memory/Context settings
OPENCLAUDE_MEMORY_ENABLED=true
OPENCLAUDE_MEMORY_PATH=/home/agent/workspace/memory
OPENCLAUDE_CONTEXT_WINDOW=200000

# Logging
OPENCLAUDE_LOG_LEVEL=info
OPENCLAUDE_LOG_DIR=/home/agent/workspace/logs

# ============================================
# Optional: GitHub Integration
# ============================================

GITHUB_TOKEN=ghp-your-token-here  # For private repos
GITHUB_USERNAME=your-username

# ============================================
# Optional: Custom Endpoints
# ============================================

# For self-hosted or custom LLM providers
# ANTHROPIC_BASE_URL=https://your-custom-endpoint.com/v1
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1
