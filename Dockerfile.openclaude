# Advanced Coding Agent - OpenClaude Runtime
# Isolated Docker Environment with OpenClaude CLI

FROM ubuntu:24.04

# Labels
LABEL description="OpenClaude coding agent environment with pre-installed skills"
LABEL version="1.0.0"
LABEL runtime="openclaude"

# Build argument for host user ID (defaults to 1000 if not provided)
# This is used to match container user UID with host user for proper file ownership
ARG HOST_UID=1000
ENV HOST_UID=${HOST_UID}

# Security: Run as non-root user
# Ubuntu 24.04 already has 'ubuntu' user with UID 1000, which matches most Linux hosts
# We rename it to 'agent' and change home directory to /home/agent
# For non-1000 UIDs, create a new agent user
RUN if [ "${HOST_UID}" = "1000" ]; then \
        # Use existing ubuntu user (UID 1000) - just rename and change home
        usermod -u 1000 -l agent -d /home/agent -m ubuntu && \
        groupmod -g 1000 -n agent ubuntu && \
        usermod -g agent agent; \
    else \
        # Create agent user with specified UID (use unique GID 9999 to avoid conflicts)
        groupadd -r -g 9999 agent && \
        useradd -r -g agent -u ${HOST_UID} -d /home/agent -m agent; \
    fi

# Configure GWDG mirror for Ubuntu packages
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://ftp.gwdg.de/pub/linux/debian/ubuntu/ubuntu/|g' etc/apt/sources.list.d/ubuntu.sources && \
    sed -i 's|http://security.ubuntu.com/ubuntu/|http://ftp.gwdg.de/pub/linux/debian/ubuntu/ubuntu/|g' etc/apt/sources.list.d/ubuntu.sources


# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    unzip \
    python3 \
    python3-venv \
    build-essential \
    ca-certificates \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 from NodeSource (required for OpenClaude)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

# Install openclaude CLI via npm
RUN npm install -g @gitlawb/openclaude

# Add npm global bin directory to PATH for agent user
ENV PATH="/usr/local/bin:/usr/local/lib/node_modules/.bin:/usr/lib/node_modules/.bin:$PATH"

# Switch to non-root user
USER agent

# Set working directory (isolated workspace)
WORKDIR /home/agent/workspace

RUN ln -sf /home/agent/workspace/.agent-memory/claude /home/agent/.claude
RUN ln -sf /home/agent/workspace/.agent-memory/openclaude /home/agent/.openclaude
RUN ln -sf /home/agent/workspace/.agent-memory/openclaude.json /home/agent/.openclaude.json
RUN ln -sf /home/agent/workspace/.agent-memory/npm /home/agent/.npm

# Pre-install essential skills from curated repos
# Matt Pocock's skills - engineering best practices
# Addy Osmani's agent-skills - production-grade workflows
# Copy pre-installed skills
COPY --chown=agent:agent skills/matt-pocock/skills /home/agent/.claude/skills
COPY --chown=agent:agent skills/addy-osmani/skills /home/agent/.claude/skills

# Create safe workspace structure
RUN mkdir -p /home/agent/workspace

# Set environment variables
ENV NODE_ENV=production \
    WORKSPACE=/home/agent/workspace \
    PATH="/usr/local/bin:/usr/local/lib/node_modules/.bin:/usr/lib/node_modules/.bin:$PATH"

# Default command - interactive bash shell
CMD ["/bin/bash"]
