# Advanced Coding Agent - OpenClaude Runtime
# Isolated Docker Environment with OpenClaude CLI

FROM ubuntu:24.04

# Labels
LABEL maintainer="Gorbad Ironfist <gorbad@openclaw.ai>"
LABEL description="OpenClaude coding agent environment with pre-installed skills"
LABEL version="2.0.0"
LABEL runtime="openclaude"

# Security: Run as non-root user
RUN groupadd -r agent && useradd -r -g agent -d /home/agent -m agent

# Set working directory (isolated workspace)
WORKDIR /home/agent/workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-venv \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install system dependencies including Node.js for openclaude CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-venv \
    build-essential \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

# Install openclaude CLI via npm
RUN npm install -g @gitlawb/openclaude

# Create agent configuration directories
RUN mkdir -p /home/agent/.openclaude/config \
    && mkdir -p /home/agent/.openclaude/skills \
    && mkdir -p /home/agent/.openclaude/workspace \
    && mkdir -p /home/agent/.openclaude/memory \
    && chown -R agent:agent /home/agent

# Pre-install essential skills from curated repos
# Matt Pocock's skills - engineering best practices
# Addy Osmani's agent-skills - production-grade workflows
RUN mkdir -p /home/agent/.openclaude/workspace/skills

# Copy agent configuration
COPY --chown=agent:agent agents.json /home/agent/.openclaude/
COPY --chown=agent:agent tools.md /home/agent/.openclaude/workspace/

# Copy pre-installed skills
COPY --chown=agent:agent skills/matt-pocock /home/agent/.openclaude/skills/matt-pocock
COPY --chown=agent:agent skills/addy-osmani /home/agent/.openclaude/skills/addy-osmani

# Create safe workspace structure
RUN mkdir -p /home/agent/workspace/projects \
    && mkdir -p /home/agent/workspace/docs \
    && mkdir -p /home/agent/workspace/temp \
    && mkdir -p /home/agent/workspace/logs \
    && chmod -R 755 /home/agent/workspace

# Set environment variables
ENV NODE_ENV=production \
    HOME=/home/agent \
    WORKSPACE=/home/agent/workspace \
    OPENCLAUDE_HOME=/home/agent/.openclaude \
    PATH="/home/agent/.local/bin:$PATH"

# Switch to non-root user
USER agent

# Health check - check if shell is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/bin/bash", "-c", "echo 'healthy'"]

# Default command - interactive bash shell
CMD ["/bin/bash"]
