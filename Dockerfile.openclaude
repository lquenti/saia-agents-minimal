# Advanced Coding Agent - OpenClaude Runtime
# Isolated Docker Environment with OpenClaude CLI

FROM node:20-bookworm-slim

# Labels
LABEL maintainer="Gorbad Ironfist <gorbad@openclaw.ai>"
LABEL description="OpenClaude coding agent environment with pre-installed skills"
LABEL version="1.0.0"
LABEL runtime="openclaude"

# Security: Run as non-root user
RUN groupadd -r agent && useradd -r -g agent -d /home/agent -m agent

# Set working directory (isolated workspace)
WORKDIR /home/agent/workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-venv \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

# Install OpenClaude CLI (placeholder - replace with actual installation)
# Note: OpenClaude installation method may vary - adjust as needed
RUN npm install -g openclaude-cli 2>/dev/null || \
    echo "OpenClaude CLI installation - adjust based on actual package name"

# Create agent configuration directories
RUN mkdir -p /home/agent/.openclaude/{config,skills,workspace} \
    && chown -R agent:agent /home/agent

# Pre-install essential skills
# These are safe, curated skills for coding agents
RUN mkdir -p /home/agent/.openclaude/workspace/skills

# Copy agent configuration
COPY --chown=agent:agent agents.json /home/agent/.openclaude/
COPY --chown=agent:agent tools.md /home/agent/.openclaude/workspace/

# Create safe workspace structure
RUN mkdir -p /home/agent/workspace/{projects,docs,temp,logs} \
    && chmod -R 755 /home/agent/workspace

# Set environment variables
ENV NODE_ENV=production \
    HOME=/home/agent \
    WORKSPACE=/home/agent/workspace \
    OPENCLAUDE_HOME=/home/agent/.openclaude \
    PATH="/home/agent/.local/bin:$PATH"

# Switch to non-root user
USER agent

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep -x openclaude || exit 1

# Default command - keep container running
CMD ["/bin/bash", "-c", "cd /home/agent/workspace && exec tail -f /dev/null"]
