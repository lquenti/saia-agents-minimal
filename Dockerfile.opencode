# Advanced Coding Agent - OpenCode Runtime
# Isolated Docker Environment with OpenCode CLI

FROM ubuntu:24.04

# Labels
LABEL maintainer="Gorbad Ironfist <gorbad@openclaw.ai>"
LABEL description="OpenCode coding agent environment with pre-installed skills"
LABEL version="1.0.0"
LABEL runtime="opencode"

# Security: Run as non-root user
RUN groupadd -r agent && useradd -r -g agent -d /home/agent -m agent

# Set working directory (isolated workspace)
WORKDIR /home/agent/workspace

# Install system dependencies including Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-venv \
    build-essential \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/ \
    && mv /root/.local/bin/uvx /usr/local/bin/

# Note: Agent CLI (opencode/openclaude) must be installed separately
# This container provides the base environment with tools and skills
# Install the CLI after container starts or use a different base image

# Create agent configuration directories
RUN mkdir -p /home/agent/.opencode/{config,skills,workspace,memory} \
    && chown -R agent:agent /home/agent

# Pre-install essential skills from curated repos
# Matt Pocock's skills - engineering best practices
# Addy Osmani's agent-skills - production-grade workflows
RUN mkdir -p /home/agent/.opencode/workspace/skills

# Copy agent configuration
COPY --chown=agent:agent agents.json /home/agent/.opencode/
COPY --chown=agent:agent tools.md /home/agent/.opencode/workspace/

# Copy pre-installed skills
COPY --chown=agent:agent skills/matt-pocock /home/agent/.opencode/skills/matt-pocock
COPY --chown=agent:agent skills/addy-osmani /home/agent/.opencode/skills/addy-osmani

# Create safe workspace structure
RUN mkdir -p /home/agent/workspace/{projects,docs,temp,logs} \
    && chmod -R 755 /home/agent/workspace

# Set environment variables
ENV NODE_ENV=production \
    HOME=/home/agent \
    WORKSPACE=/home/agent/workspace \
    OPENCODE_HOME=/home/agent/.opencode \
    PATH="/home/agent/.local/bin:$PATH"

# Switch to non-root user
USER agent

# Health check - check if shell is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/bin/bash", "-c", "echo 'healthy'"]

# Default command - interactive bash shell
CMD ["/bin/bash"]
