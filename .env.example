# Advanced Coding Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# ⚡ QUICK START - Required Settings
# ============================================
# These are the ONLY settings you need to change to get started!

# API Key for your provider (required)
# OpenCode:   OPENCODE_API_KEY=sk-...
# OpenClaude: OPENCLAUDE_API_KEY=sk-...
OPENCODE_API_KEY=your_api_key_here

# API Base URL (required for OpenAI-compatible providers)
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Azure:      https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Ollama:     http://host.docker.internal:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   Self-hosted: https://your-server.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (required)
# Examples: gpt-4o, claude-3-5-sonnet-latest, llama3.1:8b, qwen3.5-122b-a10b
MODEL=gpt-4o

# ============================================
# 🚀 How to Start
# ============================================
# The runtime is determined by which start script you use:
#   ./start-opencode.sh     → OpenCode runtime
#   ./start-openclaude.sh   → OpenClaude runtime
# No need to set RUNTIME in .env!

# ============================================
# 📋 Provider Examples (Copy one of these blocks)
# ============================================

# 🟢 OpenAI:
#   OPENCODE_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   MODEL=gpt-4o

# 🟢 Azure OpenAI:
#   OPENCODE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
#   OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/deployments/<your-deployment>
#   OPENAI_API_VERSION=2024-02-01
#   MODEL=gpt-4o

# 🟢 Ollama (local):
#   OPENCODE_API_KEY=ollama  # Can be anything for local
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   MODEL=llama3.1:8b

# 🟢 LM Studio (local):
#   OPENCODE_API_KEY=lm-studio  # Can be anything for local
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   MODEL=local-model-name

# 🟢 vLLM (local/remote):
#   OPENCODE_API_KEY=vllm  # Can be anything
#   OPENAI_BASE_URL=http://localhost:8000/v1
#   MODEL=meta-llama/Llama-3.1-8B-Instruct

# 🟢 DeepSeek:
#   OPENCODE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   MODEL=deepseek-chat

# 🟢 Groq:
#   OPENCODE_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxx
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   MODEL=llama-3.1-70b-versatile

# 🟢 Anthropic Claude (use start-openclaude.sh):
#   OPENCLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
#   MODEL=claude-3-5-sonnet-latest

# ============================================
# 🔧 Optional Settings
# ============================================

# API version (for Azure or specific providers)
# OPENAI_API_VERSION=2024-02-01

# Organization ID (optional, for OpenAI)
# OPENAI_ORG_ID=org-xxxxxxxxxx

# Project ID (optional, for OpenAI)
# OPENAI_PROJECT_ID=proj_xxxxxxxxxx

# ============================================
# Container Configuration
# ============================================
# Container name (default)
CONTAINER_NAME=advanced-coding-agent

# Port mappings (if needed for web UIs)
# OPENCODE_PORT=3000
# OPENCLAUDE_PORT=8080

# ============================================
# Workspace Settings
# ============================================
# Maximum file size for agent operations (bytes)
# Default: 100MB
MAX_FILE_SIZE=104857600

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Security Settings
# ============================================
# Allow network access (be careful!)
# WARNING: Enabling this allows the agent to make network requests
ALLOW_NETWORK=false

# Allow external API calls
# WARNING: Enabling this allows the agent to call external APIs
ALLOW_EXTERNAL_CALLS=false

# ============================================
# Git Configuration (optional)
# ============================================
# Your Git user (will be set in container)
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=your.email@example.com

# ============================================
# Advanced Settings (optional)
# ============================================
# Temperature for model responses (0.0 - 2.0)
# Higher = more creative, Lower = more deterministic
# MODEL_TEMPERATURE=0.7

# Maximum tokens for response
# MODEL_MAX_TOKENS=4096

# Timeout for API calls (seconds)
# API_TIMEOUT=120
