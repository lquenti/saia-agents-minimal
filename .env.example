# Advanced Coding Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# ⚡ QUICK START - Required Settings
# ============================================
# These are the ONLY settings you need to change to get started!

# API Key for your provider (required)
OPENCODE_API_KEY=your_api_key_here
OPENCLAUDE_API_KEY=your_api_key_here

# API Base URL (required for OpenAI-compatible providers)
OPENAI_BASE_URL=https://chat-ai.academiccloud.de/v1

# Model name (required)
# Examples: qwen3.6-27b, glm-4.7, devstral-2-123b-instruct-2512, qwen3.5-122b-a10b
MODEL=gemma-4-31b-it

# ============================================
# 🚀 OpenClaude-Specific Settings
# ============================================
# Enable OpenAI-compatible mode for OpenClaude
# Required when using non-Anthropic providers
CLAUDE_CODE_USE_OPENAI=1

# OpenAI model for OpenClaude (optional, defaults to MODEL)
# OPENAI_MODEL=claude-3-5-sonnet-latest

# ============================================
# Container Configuration
# ============================================
# Container name (default)
CONTAINER_NAME=advanced-coding-agent

# ============================================
# Workspace Settings
# ============================================
# Maximum file size for agent operations (bytes)
# Default: 100MB
MAX_FILE_SIZE=104857600

# Log level: debug, info, warn, error
LOG_LEVEL=info
