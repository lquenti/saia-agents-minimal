ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-full \
    texlive-latex-extra \
    biber \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

User agent

CMD ["/bin/bash"]
