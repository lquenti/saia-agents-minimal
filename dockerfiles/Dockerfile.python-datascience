ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Python and additional packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    libfreetype6-dev \
    libpixman-1-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda for better package management
RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -o /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh && \
    /opt/conda/bin/conda clean -afy

# Add conda to PATH
ENV PATH="/opt/conda/bin:${PATH}"

# Configure conda
RUN conda config --add channels conda-forge && \
    conda config --set always_yes yes

# Install Jupyter and related tools
RUN pip install --no-cache-dir \
    jupyter \
    jupyterlab \
    ipykernel \
    ipython-autotime \
    jupyter-contrib-nbextensions

# Configure IPython kernel
RUN python -m ipykernel install --user --name python3

# Install data science libraries
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    scipy \
    scikit-learn \
    statsmodels \
    sympy \
    networkx

# Install data visualization tools
RUN pip install --no-cache-dir \
    plotly \
    bokeh \
    altair \
    pygal

# Install data manipulation tools
RUN pip install --no-cache-dir \
    pyarrow \
    openpyxl \
    xlrd \
    xlwt \
    h5py \
    tables

# Install additional data tools
RUN pip install --no-cache-dir \
    pandas-profiling \
    sweetviz \
    dtale \
    qgrid

# Install statistical tools
RUN pip install --no-cache-dir \
    lifelines \
    statsbombpy \
 PyPI

# Configure Jupyter settings
RUN mkdir -p /home/agent/.jupyter && \
    echo "c.ServerApp.ip = '0.0.0.0'" >> /home/agent/.jupyter/jupyter_notebook_config.py && \
    echo "c.ServerApp.allow_root = True" >> /home/agent/.jupyter/jupyter_notebook_config.py && \
    echo "c.ServerApp.open_browser = False" >> /home/agent/.jupyter/jupyter_notebook_config.py

# Fix permissions
RUN chown -R agent:agent /home/agent/.jupyter /opt/conda

USER agent

CMD ["/bin/bash"]