ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Python and blockchain development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js and web3 tools
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Solidity compiler (solc)
RUN pip3 install --no-cache-dir solc

# Install Hardhat for Ethereum development
RUN npm install -g hardhat

# Install Truffle Suite
RUN npm install -g truffle && \
    npm install -g ganache

# Install web3.js development tools
RUN npm install -g web3 \
    ethers \
    web3-eth-contract

# Install Brownie for Python smart contract development
RUN pip3 install --no-cache-dir \
    brownie \
    web3 \
    eth-brownie

# Install Ape for Python web3 development
RUN pip3 install --no-cache-dir eth-ape

# Install Foundry for fast smart contract development
RUN curl -L https://foundry.paradigm.xyz | bash && \
    export PATH="/root/.foundry/bin:$PATH" && \
    foundryup

# Add Foundry to PATH
ENV PATH="/root/.foundry/bin:${PATH}"

# Install Ethereum development tools
RUN npm install -g \
    @openzeppelin/contracts \
    @chainlink/contracts

# Install debugging and testing tools
RUN npm install -g \
    hardhat-ethers \
    hardhat-ignition \
    hardhat-chai-matchers

# Install blockchain framework tools
RUN npm install -g \
    @truffle/hdwallet-provider \
    @truffle/contract

# Install additional Web3 tools
RUN npm install -g \
    slither-analyzer && \
    npm install -g mythril

# Install Ganache for local blockchain
RUN npm install -g ganache

# Install IPFS tools
RUN npm install -g ipfs-http-client \
    ipfs-desktop

# Install Substrate development tools
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    source $HOME/.cargo/env && \
    cargo install --force --git https://github.com/paritytech/polkadot-sdk.git --tag polkadot-v1.9.0 --package substrate-contracts-node

# Install Rust toolchain for blockchain development
RUN source $HOME/.cargo/env && \
    rustup component add rust-src && \
    rustup target add wasm32-unknown-unknown

# Install additional blockchain tools
RUN pip3 install --no-cache-dir \
    py-solc-x \
    pycryptodome

# Install node-specific tools
RUN npm install -g \
    @polkadot/api \
    @polkadot/util

# Install testing and security tools
RUN npm install -g \
    solidity-coverage \
    eth-gas-reporter

# Install Ethereum client tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    geth \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install blockchain monitoring tools
RUN npm install -g \
    the-graph

# Install development environment setup
RUN npm install -g \
    hardhat-shorthand

USER agent

CMD ["/bin/bash"]