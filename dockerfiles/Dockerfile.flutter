ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Flutter and Dart development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Android SDK command-line tools
RUN mkdir -p /opt/android-sdk && \
    cd /opt/android-sdk && \
    wget https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip && \
    unzip commandlinetools-linux-9477386_latest.zip && \
    rm commandlinetools-linux-9477386_latest.zip && \
    mkdir -p cmdline-tools/latest && \
    mv cmdline-tools/* cmdline-tools/latest/ && \
    chmod +x cmdline-tools/latest/bin/*

# Set Android SDK environment variables
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="${PATH}:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${ANDROID_SDK_ROOT}/build-tools/34.0.0"

# Install Android SDK components
RUN yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"

# Install Flutter SDK
RUN git clone https://github.com/flutter/flutter.git -b stable /opt/flutter && \
    /opt/flutter/bin/flutter config --no-analytics

# Set Flutter environment variables
ENV PATH="${PATH}:/opt/flutter/bin"

# Run Flutter doctor to install necessary dependencies
RUN flutter doctor --android-licenses

# Install Flutter development tools
RUN flutter pub global activate flutterfire_cli && \
    flutter pub global activate devtools

# Install Dart development tools
RUN dart pub global activate webdev && \
    dart pub global activate stagehand

# Install Gradle for Flutter builds
RUN curl -s "https://get.sdkman.io" | bash && \
    source "/root/.sdkman/bin/sdkman-init.sh" && \
    sdk install gradle 8.5

# Set Gradle environment
ENV PATH="${PATH}:/root/.sdkman/candidates/gradle/current/bin"

# Install additional development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Fix permissions for Flutter cache
RUN mkdir -p /home/agent/.flutter-sdk && \
    chown -R agent:agent /home/agent/.flutter-sdk

USER agent

CMD ["/bin/bash"]