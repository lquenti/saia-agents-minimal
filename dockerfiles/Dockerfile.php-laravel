ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install PHP and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    php8.3 \
    php8.3-cli \
    php8.3-fpm \
    php8.3-common \
    php8.3-curl \
    php8.3-mbstring \
    php8.3-xml \
    php8.3-zip \
    php8.3-bcmath \
    php8.3-intl \
    php8.3-gd \
    php8.3-mysql \
    php8.3-pgsql \
    php8.3-sqlite3 \
    php8.3-redis \
    php-xdebug \
    composer \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Laravel CLI and tools
RUN composer global require laravel/installer && \
    composer global require laravel/vapor-cli && \
    composer global require beyondcode/expose

# Add Composer global binaries to PATH
ENV PATH="${PATH}:/root/.composer/vendor/bin"

# Install web servers
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    lighttpd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install database clients
RUN apt-get update && apt-get install -y --no-install-recommends \
    mysql-client \
    postgresql-client \
    redis-tools \
    sqlite3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install PHP development tools
RUN pecl install redis && \
    docker-php-ext-enable redis

# Install Laravel packages and tools
RUN composer global require squizlabs/php_codesniffer && \
    composer global require phpstan/phpstan && \
    composer global require laravel pint

# Install testing frameworks
RUN composer global require phpunit/phpunit && \
    composer global require pestphp/pest && \
    composer global require mockery/mockery

# Install additional PHP tools
RUN composer global require friendsofphp/php-cs-fixer && \
    composer global require vimeo/psalm

# Install PHP quality tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    phpmd \
    phpcpd \
    phploc \
    pdepend \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install queue and cache drivers
RUN composer global require predis/predis && \
    composer global require enqueue/redis

# Install additional Laravel tools
RUN composer global require spatie/laravel-ray && \
    composer global require barryvdh/laravel-debugbar

# Install PHP message queue tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    librabbitmq-dev \
    && pecl install amqp && \
    docker-php-ext-enable amqp && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install PHP performance monitoring
RUN composer global require nunomaduro/clockwork

USER agent

CMD ["/bin/bash"]