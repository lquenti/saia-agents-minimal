ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Ruby and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ruby \
    ruby-dev \
    rubygems-integration \
    build-essential \
    libssl-dev \
    libreadline-dev \
    zlib1g-dev \
    libyaml-dev \
    libffi-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Rails and Ruby web frameworks
RUN gem install rails && \
    gem install sinatra && \
    gem install padrino

# Install Ruby package management tools
RUN gem install bundler && \
    gem install rake

# Install web servers for Ruby applications
RUN apt-get update && apt-get install -y --no-install-recommends \
    passenger \
    nginx-extras \
    puma \
    unicorn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for Rails asset pipeline
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install JavaScript build tools for Rails
RUN npm install -g webpack webpack-cli && \
    npm install -g rollup && \
    npm install -g terser

# Install Ruby testing frameworks
RUN gem install rspec && \
    gem install cucumber && \
    gem install minitest && \
    gem install test-unit

# Install Ruby development tools
RUN gem install rubocop && \
    gem install rubocop-performance && \
    gem install rubocop-rails && \
    gem install brakeman && \
    gem install reek

# Install Ruby database tools
RUN gem install pg && \
    gem install mysql2 && \
    gem install sqlite3 && \
    gem install redis && \
    gem install mongoid

# Install Ruby job queue tools
RUN gem install sidekiq && \
    gem install resque && \
    gem install delayed_job

# Install API development tools
RUN gem install grape && \
    gem install graphql && \
    gem install jbuilder

# Install Ruby performance tools
RUN gem install rack-mini-profiler && \
    gem install bullet && \
    gem install scout_apm

# Install additional Ruby web tools
RUN gem install cancancan && \
    gem install devise && \
    gem install pundit && \
    gem install activeadmin

# Install Ruby development environment tools
RUN gem install pry && \
    gem install pry-byebug && \
    gem install pry-rails && \
    gem install byebug

# Install Ruby deployment tools
RUN gem install capistrano && \
    gem install mina

USER agent

CMD ["/bin/bash"]