ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Python and NLP libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install spaCy and NLP libraries
RUN pip install --no-cache-dir \
    spacy \
    spacy-transformers \
    NLTK \
    textblob

# Download spaCy models
RUN python -m spacy download en_core_web_sm && \
    python -m spacy download en_core_web_md && \
    python -m spacy download en_core_web_lg

# Install transformers and LLM tools
RUN pip install --no-cache-dir \
    transformers \
    tokenizers \
    datasets \
    accelerate \
    bitsandbytes \
    peft

# Install Hugging Face tools
RUN pip install --no-cache-dir \
    huggingface-hub \
    hf_transfer \
    optimum

# Install NLP libraries
RUN pip install --no-cache-dir \
    gensim \
    wordcloud \
    textstat \
    pyemd

# Install fine-tuning tools
RUN pip install --no-cache-dir \
    trl \
    transformers[torch] \
    peft \
    bitsandbytes

# Install NLP frameworks
RUN pip install --no-cache-dir \
    langchain \
    langchain-community \
    langchain-core \
    openai \
    anthropic

# Install text generation tools
RUN pip install --no-cache-dir \
    text-generation-inference \
    vllm

# Install sentence embeddings
RUN pip install --no-cache-dir \
    sentence-transformers \
    sentencepiece

# Install NLP utilities
RUN pip install --no-cache-dir \
    sacremoses \
    sacrebleu \
    rouge-score
* bert-score

# Install text preprocessing tools
RUN pip install --no-cache-dir \
    beautifulsoup4 \
    lxml \
    html5lib

# Install additional NLP tools
RUN pip install --no-cache-dir \
    contractions \
    ftfy \
    unidecode

# Install language detection
RUN pip install --no-cache-dir \
    langdetect \
    fasttext

# Install topic modeling
RUN pip install --no-cache-dir \
    bertopic \
    gensim

# Install text classification tools
RUN pip install --no-cache-dir \
    transformers \
    simpletransformers

# Install NLP evaluation tools
RUN pip install --no-cache-dir \
    rouge \
    nltk \
    sacrebleu

# Install visualization tools
RUN pip install --no-cache-dir \
    matplotlib \
    seaborn \
    wordcloud

USER agent

CMD ["/bin/bash"]