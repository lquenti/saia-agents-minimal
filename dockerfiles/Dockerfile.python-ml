ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Python and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    git \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install required system libraries for ML
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    libssl-dev \
    libffi-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with CPU support
RUN pip install --no-cache-dir torch torchvision torchaudio

# Install TensorFlow and Keras
RUN pip install --no-cache-dir tensorflow keras

# Install XGBoost and LightGBM
RUN pip install --no-cache-dir xgboost lightgbm catboost

# Install scikit-learn and additional ML tools
RUN pip install --no-cache-dir \
    scikit-learn \
    imbalanced-learn \
    optuna \
    hyperopt

# Install MLflow for experiment tracking
RUN pip install --no-cache-dir mlflow

# Install Weights & Biases
RUN pip install --no-cache-dir wandb

# Install DVC for data version control
RUN pip install --no-cache-dir dvc

# Install deep learning frameworks
RUN pip install --no-cache-dir \
    transformers \
    timm \
    albumentations

# Install serving and deployment tools
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    streamlit \
    gradio \
    flask

# Install model optimization tools
RUN pip install --no-cache-dir \
    onnx \
    onnxruntime \
    tensorrt

# Install monitoring and profiling tools
RUN pip install --no-cache-dir \
    tensorboard \
    wandb

# Install ML orchestration tools
RUN pip install --no-cache-dir \
    prefect \
    dagster \
    airflow

# Install data processing tools for ML
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    pillow \
    opencv-python-headless

USER agent

CMD ["/bin/bash"]