ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install Python and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install web framework CLIs
RUN pip install --no-cache-dir django && \
    pip install --no-cache-dir flask && \
    pip install --no-cache-dir fastapi && \
    pip install --no-cache-dir pyramid

# Install Django tools
RUN pip install --no-cache-dir \
    django-admin \
    django-extensions \
    django-debug-toolbar \
    django-cors-headers

# Install Flask tools
RUN pip install --no-cache-dir \
    flask-cors \
    flask-sqlalchemy \
    flask-migrate \
    flask-login \
    flask-restx

# Install FastAPI tools
RUN pip install --no-cache-dir \
    uvicorn[standard] \
    gunicorn \
    pydantic \
    sqlalchemy \
    alembic

# Install async database tools
RUN pip install --no-cache-dir \
    asyncpg \
    aiomysql \
    redis \
    celery

# Install web development tools
RUN pip install --no-cache-dir \
    requests \
    httpx \
    aiohttp \
    beautifulsoup4 \
    selenium \
    playwright

# Install testing tools for web development
RUN pip install --no-cache-dir \
    pytest \
    pytest-django \
    pytest-flask \
    pytest-asyncio \
    coverage

# Install API documentation tools
RUN pip install --no-cache-dir \
    swagger-ui-py \
    flasgger

# Install websocket tools
RUN pip install --no-cache-dir \
    websockets \
    socketio

# Install API clients
RUN pip install --no-cache-dir \
    graphene \
    graphene-django \
    strawberry

# Install additional web tools
RUN pip install --no-cache-dir \
    jinja2 \
    werkzeug \
    markupsafe \
    itsdangerous

USER agent

CMD ["/bin/bash"]