ARG BASE_IMAGE=localhost/advanced-coding-agent-opencode:latest

FROM ${BASE_IMAGE}

USER root

# Install database clients and tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    mysql-client \
    sqlite3 \
    redis-tools \
    mongodb-clients \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install database migration tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    flyway \
    liquibase \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Redis CLI and tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    redis-server \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install MongoDB tools
RUN wget -qO - https://www.mongodb.org/static/pgp/server-7.0.asc | apt-key add - && \
    echo "deb [ arch=amd64,arm64 ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" | tee /etc/apt/sources.list.d/mongodb-org-7.0.list && \
    apt-get update && \
    apt-get install -y mongodb-org-tools mongodb-org-shell && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install PostgreSQL development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-contrib \
    libpq-dev \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install database administration tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    pgadmin3 \
    mysql-workbench \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install DBeaver for database management
RUN wget -O - https://dbeaver.io/debs/dbeaver.gpg.key | apt-key add - && \
    echo "deb https://dbeaver.io/debs/dbeaver-ce /" | tee /etc/apt/sources.list.d/dbeaver.list && \
    apt-get update && \
    apt-get install -y dbeaver-ce && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python database tools
RUN pip3 install --no-cache-dir \
    sqlalchemy \
    psycopg2-binary \
    pymysql \
    pymongo \
    redis-py \
    pymssql

# Install Node.js database tools
RUN npm install -g knex && \
    npm install -g typeorm && \
    npm install -g prisma && \
    npm install -g mongo-express

# Install database performance monitoring tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    pgbench \
    sysbench \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install database backup and restore tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    automysqlbackup \
    automysqlbackup \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install additional database development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    pgloader \
    mycli \
    pgcli \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install ETL and data integration tools
RUN pip3 install --no-cache-dir \
    apache-airflow \
    luigi \
    dbt-postgres

# Install message queue tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    rabbitmq-server \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install database documentation tools
RUN pip3 install --no-cache-dir \
    schemacrawler

USER agent

CMD ["/bin/bash"]